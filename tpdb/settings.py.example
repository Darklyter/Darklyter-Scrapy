# https://docs.scrapy.org/en/latest/topics/downloader-middleware.html#httpcache-middleware-settings
HTTPCACHE_ENABLED = False
COMPRESSION_ENABLED = True
HTTPCACHE_EXPIRATION_SECS = 7200
HTTPCACHE_DIR = 'httpcache'
# HTTPCACHE_IGNORE_HTTP_CODES = []
HTTPCACHE_STORAGE = 'scrapy.extensions.httpcache.FilesystemCacheStorage'
# Scrapy already defaults to the asyncio reactor; the pipelines await their API
# calls, so do not switch this to a non-asyncio reactor.
# TWISTED_REACTOR = 'twisted.internet.asyncioreactor.AsyncioSelectorReactor'
# DUPEFILTER_DEBUG = True

LOG_LEVEL = 'INFO'
DEFAULT_EXPORT_PATH = "./jsonexport"
PUPPETEER_SERVICE_URL = 'http://127.0.0.1:3000'

# ~ DOWNLOADER_CLIENT_TLS_METHOD = 'TLSv1.2'
REQUEST_FINGERPRINTER_IMPLEMENTATION = '2.7'
DOWNLOADER_CLIENT_TLS_CIPHERS = 'DEFAULT:!DH'

# CHANGE ME if you run FlareSolverr or an HTTP proxy.  Leave as-is otherwise;
