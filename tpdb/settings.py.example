FLARE_ADDRESS = 'http://127.0.0.1:8191/v1'
FLARE_URL = 'http://127.0.0.1:8191'
FLARE_API = 'http://127.0.0.1:8191'
PROXY_ADDRESS = 'http://127.0.0.1:8118'
USE_PROXY = False

RETRY_HTTP_CODES = [500, 502, 503, 504, 522, 524, 408, 429, 403, 302]

# MongoDB is used only as a "already scraped" cache and is off by default.
ENABLE_MONGODB = False
MONGODB_URL = ''

# CHANGE ME.  Without an API key every run behaves as though -s local=true was
# passed: items are scraped and displayed but never submitted.
TPDB_API_KEY = ''
TPDB_TEST_API_KEY = ''

DAYS = 20
WAYBACK_MACHINE_TIME_RANGE = (20100101001119, 20200105001119)

# Tag alias file, relative to the directory you run scrapy from.
FILTER_TAGS = True
FILTER_TAG_FILENAME = 'stashtags.json'

DISPLAY_ITEMS = True
EXPORT_ITEMS = True

# CHANGE ME.  Only used by file-downloading spiders.
FILES_STORE = "./downloads/"
CHECK_PATHS = ['./downloads/']
DUPEFILE_PATH = 'dupefiles/dupelist-'

# CHANGE ME if you run a local TPDB or StashDB instance.  These are only used by
